# =====================================================
# ANALYZE PAGE
# =====================================================
if page == "Analyze":
    st.title("🌍 Satellite Analyzer")
    model = load_model()
    data = load_data()
    uploaded = st.file_uploader("Upload Satellite Image", type=["png","jpg","jpeg"])

    if uploaded:
        image = Image.open(uploaded).convert("RGB")
        st.image(image, use_column_width=True)
        features = extract_all_features(image)

        if not data.empty and data.shape[1]-1 != len(features):
            st.warning("Feature mismatch detected. Resetting model.")
            reset_model()
            data = pd.DataFrame()
            model = RandomForestClassifier(n_estimators=200)

        if not data.empty:
            X = data.drop("label", axis=1)
            y = data["label"]
            model.fit(X, y)
            prediction = model.predict([features])[0]
            st.success(f"🧠 AI Prediction: {prediction}")
        else:
            st.warning("Model not trained yet.")

        st.subheader("Correct the AI")
        label = st.selectbox("Actual Class", ["River","Forest","Mountain","Urban","Desert","Agriculture"])
        if st.button("Save & Retrain"):
            filename = datetime.now().strftime("%Y%m%d_%H%M%S")+".png"
            image.save(os.path.join(IMAGE_FOLDER, filename))
            row = list(features) + [label]
            if data.empty:
                cols = [f"f{i}" for i in range(len(features))] + ["label"]
                data = pd.DataFrame([row], columns=cols)
            else:
                new_row = pd.DataFrame([row], columns=data.columns)
                data = pd.concat([data, new_row], ignore_index=True)
            save_data(data)
            model.fit(data.drop("label", axis=1), data["label"])
            save_model(model)
            st.success("Model updated successfully.")

