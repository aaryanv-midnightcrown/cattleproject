import streamlit as st
import os
import numpy as np
import pandas as pd
import torch
import torchvision.models as models
import torchvision.transforms as transforms
import cv2
from PIL import Image, ImageDraw
from sklearn.ensemble import RandomForestClassifier
import joblib
from datetime import datetime
import time

# =====================================================
# CONFIGURATION
# =====================================================
st.set_page_config(page_title="Sentinel AI Pro", layout="wide")
MODEL_PATH = "model/sentinel_model.pkl"
DATA_PATH = "data/training_data.csv"
IMAGE_FOLDER = "images/"
os.makedirs("model", exist_ok=True)
os.makedirs("data", exist_ok=True)
os.makedirs("images", exist_ok=True)
os.makedirs("assets", exist_ok=True)

# =====================================================
# LOAD CNN (ResNet50)
# =====================================================
@st.cache_resource
def load_cnn():
    model = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)
    model = torch.nn.Sequential(*(list(model.children())[:-1]))
    model.eval()
    return model

cnn = load_cnn()
transform = transforms.Compose([
    transforms.Resize((224,224)),
    transforms.ToTensor(),
])

# =====================================================
# FEATURE EXTRACTION
# =====================================================
def extract_deep_features(image):
    img = transform(image).unsqueeze(0)
    with torch.no_grad():
        features = cnn(img).squeeze().numpy()
    return features

def extract_ndvi_like(image):
    img = np.array(image)
    r = img[:,:,0].astype(float)
    g = img[:,:,1].astype(float)
    ndvi = (g - r) / (g + r + 1e-5)
    return np.mean(ndvi)

def extract_edge_density(image):
    img = np.array(image)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    edges = cv2.Canny(gray,100,200)
    return np.mean(edges)

def extract_all_features(image):
    deep = extract_deep_features(image)
    ndvi = extract_ndvi_like(image)
    edge = extract_edge_density(image)
    return np.concatenate([deep, [ndvi, edge]])

# =====================================================
# DATA HANDLING
# =====================================================
def load_data():
    if os.path.exists(DATA_PATH):
        return pd.read_csv(DATA_PATH)
    return pd.DataFrame()

def save_data(df):
    df.to_csv(DATA_PATH, index=False)

def load_model():
    if os.path.exists(MODEL_PATH):
        return joblib.load(MODEL_PATH)
    return RandomForestClassifier(n_estimators=200)

def save_model(model):
    joblib.dump(model, MODEL_PATH)

def reset_model():
    if os.path.exists(MODEL_PATH):
        os.remove(MODEL_PATH)
    if os.path.exists(DATA_PATH):
        os.remove(DATA_PATH)

# =====================================================
# SIDEBAR NAVIGATION
# =====================================================
