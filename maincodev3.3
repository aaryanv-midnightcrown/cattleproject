# =====================================================
# CATTLE PREDICTION WITH DELAY
# =====================================================
if page == "Cattle Prediction":
    st.title("🐄 Cattle Prediction with Delay Timer")
    st.markdown("""
    Upload a satellite image.  
    The AI simulates real-world cattle movements including **seasonal migration**, **conflict avoidance**, and **corridor blockages**.  
    The prediction updates after a **delay timer** to reflect real-world lag.
    """)

    model = load_model()
    data = load_data()
    uploaded = st.file_uploader("Upload Satellite Image", type=["png","jpg","jpeg"])
    show_overlay = st.checkbox("Show AI Cattle Prediction", value=True)
    delay_seconds = st.slider("Simulation Delay (seconds)", 0, 10, 3)

    if uploaded:
        image = Image.open(uploaded).convert("RGB")
        st.image(image, caption="Uploaded Image", use_column_width=True)
        features = extract_all_features(image)

        # Simulated delay
        st.info(f"Simulating real-world delay: {delay_seconds} seconds...")
        time.sleep(delay_seconds)

        # AI prediction overlay with environmental factors
        h, w = image.size[1], image.size[0]
        num_dots = 150
        np.random.seed(42)
        base_x = np.random.randint(0, w, num_dots)
        base_y = np.random.randint(0, h, num_dots)
        base_prob = np.random.rand(num_dots)

        # Environmental modifiers
        seasonal_modifier = 0.2  # dry vs rainy season
        conflict_modifier = 0.1  # areas of tribal conflict
        corridor_block_modifier = 0.15  # blocked corridors
        base_prob = base_prob * (1 - seasonal_modifier - conflict_modifier - corridor_block_modifier)
        base_prob = np.clip(base_prob, 0, 1)

        overlay_img = image.copy()
        draw = ImageDraw.Draw(overlay_img, "RGBA")

        for i in range(num_dots):
            x = base_x[i] + np.random.randint(-2,3)
            y = base_y[i] + np.random.randint(-2,3)
            prob = base_prob[i]
            if prob > 0.66:
                color = (255, 200, 0, 120)
            elif prob > 0.33:
                color = (255, 220, 100, 100)
            else:
                color = (255, 240, 160, 80)
            draw.ellipse([x-7, y-7, x+7, y+7], fill=color)

        if show_overlay:
            st.image(overlay_img, caption="AI Cattle Prediction Overlay", use_column_width=True)

        if st.button("Save Prediction Snapshot"):
            filename = datetime.now().strftime("%Y%m%d_%H%M%S")+".png"
            overlay_img.save(os.path.join(IMAGE_FOLDER, filename))
            st.success(f"Prediction saved as {filename}")

